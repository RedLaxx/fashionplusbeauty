---
import { getCollection, render } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import StoryCard from '@/components/StoryCard.astro';
import ResponsivePicture from '@/components/ResponsivePicture.astro';
import AdSlot from '@/components/AdSlot.astro';
import { categories } from '@/lib/categories';
import { articleUrl, byNewest, formatDate, isPublished, imageUrl } from '@/lib/content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', isPublished);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const data = article.data;
const category = categories[data.category];
const allArticles = (await getCollection('articles', isPublished)).sort(byNewest);
const related = allArticles.filter((item) => item.id !== article.id).slice(0, 3);
const canonicalPath = articleUrl(article);
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://fashionplusbeauty.pages.dev').replace(/\/$/, '');
const canonicalUrl = new URL(canonicalPath, `${siteUrl}/`).toString();
const pinMedia = imageUrl(data.pinImage || data.heroImage);
const pinHref = new URL('https://www.pinterest.com/pin/create/button/');
pinHref.searchParams.set('url', canonicalUrl);
pinHref.searchParams.set('media', pinMedia);
pinHref.searchParams.set('description', data.title);
const title = data.seoTitle || `${data.title} | FashionPlusBeauty`;
const description = data.seoDescription || data.description;
---
<SiteLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  image={data.pinImage || data.heroImage}
  imageAlt={data.heroAlt}
  article={data}
>
  <div class="article-topline page-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href={`/category/${data.category}/`}>{category.label}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{data.title}</span>
    </nav>
  </div>

  <header class="article-header">
    <a class="eyebrow category-link" href={`/category/${data.category}/`}>{category.eyebrow}</a>
    <h1>{data.title}</h1>
    <p class="article-deck">{data.description}</p>
    <div class="article-byline">
      <strong>By {data.author}</strong><span class="byline-dot" aria-hidden="true">✳</span>
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time><span class="byline-dot" aria-hidden="true">✳</span>
      <span>{data.readTime} min read</span>
    </div>
  </header>

  <figure class="article-cover">
    <ResponsivePicture
      src={data.heroImage}
      alt={data.heroAlt}
      width="1440"
      height="1000"
      loading="eager"
      fetchpriority="high"
      sizes="(max-width: 800px) calc(100vw - 40px), 1030px"
    />
    <figcaption>Image: FashionPlusBeauty editorial</figcaption>
  </figure>

  <div class="article-toolbar page-shell">
    <span class="article-toolbar-label">Enjoying this story? Keep it close.</span>
    <div class="article-share-actions">
      <a class="article-share-button" href={pinHref.toString()} target="_blank" rel="noopener noreferrer" aria-label={`Save ${data.title} to Pinterest`}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5a6.5 6.5 0 0 0-2.36 12.56c-.06-.54-.11-1.37.02-1.96l.82-3.49s-.21-.42-.21-1.04c0-.98.57-1.71 1.28-1.71.6 0 .89.45.89.99 0 .6-.38 1.49-.57 2.32-.16.69.35 1.25 1.03 1.25 1.24 0 2.2-1.31 2.2-3.2 0-1.67-1.2-2.84-2.91-2.84-1.98 0-3.15 1.49-3.15 3.03 0 .6.23 1.24.52 1.59.06.07.07.14.05.21l-.2.8c-.03.13-.1.16-.23.1-.86-.4-1.4-1.64-1.4-2.64 0-2.15 1.56-4.13 4.5-4.13 2.36 0 4.2 1.68 4.2 3.92 0 2.34-1.47 4.23-3.5 4.23-.68 0-1.33-.36-1.55-.79l-.42 1.6c-.15.59-.56 1.32-.83 1.77A6.5 6.5 0 1 0 8 1.5Z"/></svg>
        Save to Pinterest
      </a>
      <button class="article-share-button" type="button" data-copy-link={canonicalUrl}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.2 9.8 9.8 6.2M5.4 11.7l-1.1 1.1a2.55 2.55 0 0 1-3.6-3.6l3-3a2.55 2.55 0 0 1 3.6 0M10.6 4.3l1.1-1.1a2.55 2.55 0 0 1 3.6 3.6l-3 3a2.55 2.55 0 0 1-3.6 0"/></svg>
        <span data-copy-label>Copy link</span>
      </button>
    </div>
    <span class="visually-hidden" data-copy-status aria-live="polite"></span>
  </div>

  <div class="article-layout">
    <article class="article-content" aria-label="Article body">
      <Content />
      {data.affiliateDisclosure && (
        <aside class="affiliate-note" id="affiliate-note">
          <strong>A note about shopping links:</strong> This story contains affiliate links. If you choose to shop through them, FashionPlusBeauty may earn a small commission at no extra cost to you. We only share links that fit the story.
        </aside>
      )}
    </article>

    <aside class="article-sidebar" aria-label="More from FashionPlusBeauty">
      {headings.filter((heading) => heading.depth === 2).length > 0 && (
        <nav class="article-toc" aria-label="In this story">
          <p>In this story</p>
          <ol>
            {headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="article-sidebar-card">
        <p class="eyebrow">A little more lovely</p>
        <h2>Good reads, good finds.</h2>
        <p>Get new stories and thoughtful edits in your inbox, whenever we have something worth sharing.</p>
        <a class="text-link" href="#newsletter">Join the note <span aria-hidden="true">→</span></a>
      </div>
      <AdSlot placement="article" label="Advertisement" />
    </aside>
  </div>

  <div class="article-end-card">
    <div>
      <p class="eyebrow">More from the {category.label.toLowerCase()} edit</p>
      <h2>Keep the inspiration going.</h2>
    </div>
    <a class="button" href={`/category/${data.category}/`}>Explore {category.label} <span aria-hidden="true">→</span></a>
  </div>

  {related.length > 0 && (
    <section class="article-more content-section page-shell" aria-labelledby="related-heading">
      <div class="section-heading">
        <div><p class="section-kicker">One more thing</p><h2 id="related-heading">You might like these</h2></div>
        <a class="text-link" href="/search/">All stories <span aria-hidden="true">→</span></a>
      </div>
      <div class="story-grid">{related.map((story) => <StoryCard article={story} />)}</div>
    </section>
  )}
</SiteLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = button.dataset.copyLink;
      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      const status = document.querySelector<HTMLElement>('[data-copy-status]');
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        if (label) label.textContent = 'Copied!';
        if (status) status.textContent = 'Story link copied to clipboard.';
      } catch {
        if (label) label.textContent = 'Copy unavailable';
        if (status) status.textContent = 'Please copy this page address from your browser.';
      }
      window.setTimeout(() => { if (label) label.textContent = 'Copy link'; }, 2200);
    });
  });
</script>
